[color]
    ui = auto
[core]
    editor = vim
    pager = delta
[interactive]
    # Makes the ap / cop / rp aliases below show delta's diff too
    diffFilter = delta --color-only
[delta]
    # No syntax theme on purpose. Colors come from the terminal palette, which
    # is defined once in config/ghostty/config.
    syntax-theme = none
    line-numbers = true
[push]
    default = simple
[alias]
    a  = add
    aa = add -A
    ap = add -p
    c  = commit --verbose
    ca = commit --amend
    can = commit --amend --no-edit
    cm = commit -m
    st = status
    co = checkout
    cop = checkout -p
    rp = reset -p
    br = branch
    df = diff
    dfs = diff --staged
    lg = log --graph --all --format="%C(cyan)%an%Creset%x09%C(yellow)%h%Creset%x09%s"

# Identity is never committed. The default is personal; the work address is
# switched in per directory below. Defaulting to personal means a forgotten
# directory leaks nothing about work into a public repo.
[include]
    path = ~/.gitconfig.local
[includeIf "gitdir:~/Development/vacan_technologies/"]
    path = ~/.gitconfig.work
[includeIf "gitdir:~/Development/vacancorp/"]
    path = ~/.gitconfig.work
