# Ghostty -- symlinked to ~/.config/ghostty/config by bin/setup.sh
#
# THIS FILE IS THE ONLY PLACE COLORS ARE DEFINED.
#
# Everything that draws in the terminal inherits the 16 ANSI colors from the
# theme below instead of carrying a palette of its own:
#   - Claude Code   "theme": "dark-ansi" / "light-ansi", flipped by hand
#   - status line   ANSI codes only        (see bin/statusline.py)
#   - codex         status_line_use_colors = false in ~/.codex/config.toml
#   - vim           no colorscheme, no t_Co, no background (see .vim/vimrc)
#   - git-delta     syntax-theme disabled  (see .gitconfig)
#   - starship      ANSI color names only  (see config/starship.toml)
#   - fzf / tig     no color options set
#
# To change the look of every one of them, change the one line below.
# `ghostty +list-themes` shows what is available.
#
# Two themes, one per macOS appearance. Ghostty watches the system setting and
# swaps the palette live -- no reload, no restart. `window-theme` is left at its
# default `auto`, so the titlebar follows the background it is handed.
#
# Anything drawing in the 16 ANSI slots follows for free, and the two tools that
# keep a light/dark notion of their own ask the terminal which one it is: vim
# through t_RB, git-delta through OSC 10/11. Claude Code is the one that cannot
# ask, so its theme is pinned; see CLAUDE.md.

# Both halves are picked for legibility rather than looks, because every CLI
# here draws its secondary text -- line numbers, timings, unchanged diff lines
# -- with SGR 2, which Ghostty renders by blending the foreground halfway into
# the background. That blend is what a light theme has to survive, and most do
# not: the usual failure is a light theme carrying its dark sibling's bright
# row, where slots 8-15 were chosen against a dark background and measure under
# 2 against a white one. Of the 77 light themes Ghostty ships, three clear a
# 3:1 floor on the faint blend, the dim slot and all twelve color slots at
# once, and this pair is the only one of the three whose dark half matches it.
# Here the faint blend lands at 3.56 on light and 4.93 on dark, and the weakest
# of those twelve is 3.61 -- light's slot 14, #3192aa.
#
# Check a replacement the same way before swapping it in. A theme that reads
# well in a screenshot of prose can still be unusable for this, and the fix is
# a better theme -- minimum-contrast and faint-opacity look like they solve it,
# but they clamp toward black or white and take the green out of a diff.
#
# One floor is deliberately missing from that list, because no theme clears it.
# Every number above measures a slot against the background. A tool that fills a
# panel with ANSI 8 and then writes on top needs slot 8 to work as a background
# as well, and this pair manages 2.43 on light and 2.18 on dark. Slot 8 cannot be
# far from the background -- so faint text reads against it -- and far from the
# foreground -- so a fill reads under it -- with enough left to survive SGR 2
# halving one of them; measured across all 463 themes Ghostty ships, none can.
# So that one is settled in the tool that paints the fill, never here. herdr
# settled it by leaving this palette for Catppuccin -- see config/herdr/config.toml.
#
# Claude Code cannot, and it is the one thing a replacement theme should be picked
# to fix. It fills the user's own message and has only `dark-ansi` and
# `light-ansi` to choose between, so the light half above works (ANSI 0 on ANSI 7,
# 3.75) and the dark half does not: 2.43 for dark-ansi, 2.87 for light-ansi, no
# third option. It is the only sub-3:1 number left here. 15 of the 386 dark themes
# Ghostty ships clear the existing floors and text-on-slot-8 together -- Monokai
# Remastered 6.00, Cobalt Next Dark 4.86, Dracula 4.71, Xcode Dark hc 3.53 -- and
# swapping the dark half in is its own piece of work, this divider included.
theme = light:GitHub Light High Contrast,dark:GitHub Dark High Contrast

# The split divider, and the one hardcoded color in this setup.
#
# Ghostty leaves split-divider-color empty by default and derives the line from
# the background, which on a dark theme puts it within a hair of that background
# -- the divider is effectively invisible. It has to be stated explicitly.
#
# It cannot be stated the way everything else here gets its colors. The option
# takes a literal only: a palette index (`8`) and an ANSI name (`bright-black`)
# are both rejected, so it cannot point at a terminal slot. Nor can it be given
# per appearance -- `theme` is the only key that accepts a `light:,dark:` pair,
# and Ghostty has no conditional config -- so one value has to serve both
# halves of the pair above.
#
# #66707b is that value. It is GitHub Light High Contrast's palette 7 rather
# than an invented color, and being a mid tone it clears both backgrounds by a
# similar margin: 5.04 contrast against light #ffffff, 3.89 against dark
# #0a0c10. Every darker or lighter candidate wins one background by losing the
# other -- the dark half's own dim gray, #9ea7b3, drops to 2.43 on light.
#
# This is the one line that does not follow the theme. Changing the theme pair
# above means checking this value against the new backgrounds.
split-divider-color = #66707b

# The font *family* is deliberately left unset: Ghostty's built-in default is
# fine and one less thing to install on a new machine. Only the size moves,
# one step down from the default 13.
font-size = 12

# Ghostty's default padding is 2px, which leaves the text touching the window
# edge. These give it room to breathe; `balance` splits the leftover pixels --
# the window is rarely an exact multiple of the cell size -- evenly across both
# sides instead of dumping all of it on the right and bottom.
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true

# Let Ghostty know where the prompt starts and ends. This is what makes new
# tabs and splits inherit the current directory, and cmd+up/down jump between
# commands.
shell-integration = zsh

# Send Option as Alt so the emacs-style word motions in zsh work
# (option+b / option+f / option+d). Costs the ability to type composed
# characters with Option, which the Japanese IME does not need.
macos-option-as-alt = true

# Drop a terminal down over whatever app is in front. This is the fastest path
# to `claude`, `codex` or `cursor-agent` from anywhere.
keybind = global:cmd+backquote=toggle_quick_terminal
