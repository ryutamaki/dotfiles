# Ghostty -- symlinked to ~/.config/ghostty/config by bin/setup.sh
#
# THIS FILE IS THE ONLY PLACE COLORS ARE DEFINED.
#
# Everything that draws in the terminal inherits the 16 ANSI colors from the
# theme below instead of carrying a palette of its own:
#   - Claude Code   "theme": "dark-ansi"   in ~/.claude/settings.json
#   - status line   ANSI codes only        (see bin/statusline.py)
#   - codex         status_line_use_colors = false in ~/.codex/config.toml
#   - vim           no colorscheme, no t_Co, no background (see .vim/vimrc)
#   - git-delta     syntax-theme disabled  (see .gitconfig)
#   - fzf / tig     no color options set
#
# To change the look of every one of them, change the one line below.
# `ghostty +list-themes` shows what is available.
#
# Two themes, one per macOS appearance. Ghostty watches the system setting and
# swaps the palette live -- no reload, no restart. `window-theme` is left at its
# default `auto`, so the titlebar follows the background it is handed.
#
# Anything drawing in the 16 ANSI slots follows for free, and the two tools that
# keep a light/dark notion of their own ask the terminal which one it is: vim
# through t_RB, git-delta through OSC 10/11. Claude Code is the one that cannot
# ask, so its theme is pinned; see CLAUDE.md.

theme = light:TokyoNight Day,dark:TokyoNight

# The split divider, and the one hardcoded color in this setup.
#
# Ghostty leaves split-divider-color empty by default and derives the line from
# the background, which on TokyoNight puts it within a hair of #1a1b26 -- the
# divider is effectively invisible. It has to be stated explicitly.
#
# It cannot be stated the way everything else here gets its colors. The option
# takes a literal only: a palette index (`8`) and an ANSI name (`bright-black`)
# are both rejected, so it cannot point at a terminal slot. Nor can it be given
# per appearance -- `theme` is the only key that accepts a `light:,dark:` pair,
# and Ghostty has no conditional config -- so one value has to serve both
# halves of the pair above.
#
# #6172b0 is that value. It is TokyoNight Day's palette 7 rather than an
# invented color, and being a mid tone it clears both backgrounds by a similar
# margin: 3.70 contrast against dark #1a1b26, 3.57 against light #e1e2e7. Every
# darker or lighter candidate wins one background by losing the other -- the
# theme's own bright black, #414868, drops to 1.91 on dark.
#
# This is the one line that does not follow the theme. Changing the theme pair
# above means checking this value against the new backgrounds.
split-divider-color = #6172b0

# The font *family* is deliberately left unset: Ghostty's built-in default is
# fine and one less thing to install on a new machine. Only the size moves,
# one step down from the default 13.
font-size = 12

# Ghostty's default padding is 2px, which leaves the text touching the window
# edge. These give it room to breathe; `balance` splits the leftover pixels --
# the window is rarely an exact multiple of the cell size -- evenly across both
# sides instead of dumping all of it on the right and bottom.
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true

# Let Ghostty know where the prompt starts and ends. This is what makes new
# tabs and splits inherit the current directory, and cmd+up/down jump between
# commands.
shell-integration = zsh

# Send Option as Alt so the emacs-style word motions in zsh work
# (option+b / option+f / option+d). Costs the ability to type composed
# characters with Option, which the Japanese IME does not need.
macos-option-as-alt = true

# Drop a terminal down over whatever app is in front. This is the fastest path
# to `claude`, `codex` or `cursor-agent` from anywhere.
keybind = global:cmd+backquote=toggle_quick_terminal
